# Server
NODE_ENV=development
PORT=3001

# Security - CHANGE THESE BEFORE PRODUCTION
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@artisttiwari.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!

# CORS - production: https://your-domain.com
# local Live Server examples can be comma-separated
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Production database (next migration step)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/artist_tiwari
